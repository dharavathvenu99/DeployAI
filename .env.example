# DeployAI - Local Docker Compose Environment Variables
# Copy this file to .env and fill in your values
# For local testing, you can leave API keys empty (demo mode will work)

# Core Configuration
DEMO_MODE=false
DATABASE_URL=postgresql://deployai:deployai_secure_pass_2024@postgres:5432/deployai?sslmode=disable
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# AI & Integrations (optional - leave empty for demo mode)
GEMINI_API_KEY=
GITHUB_TOKEN=
NETLIFY_AUTH_TOKEN=
VERCEL_TOKEN=
RENDER_API_KEY=
RAILWAY_API_KEY=

# Optional
LOG_LEVEL=INFO
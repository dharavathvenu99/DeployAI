# DeployAI Environment Configuration Example

# Demo Mode toggle (set to true to run fully without cloud credentials)
DEMO_MODE=true

# Google Gemini API Key for deep AI architecture analysis & error fixes
GEMINI_API_KEY=

# GitHub Personal Access Token (optional, for accessing private repos or avoiding rate limits)
GITHUB_TOKEN=

# Real Cloud Provider API Keys (optional; used when DEMO_MODE=false)
VERCEL_TOKEN=
RENDER_API_KEY=
RAILWAY_API_KEY=
NETLIFY_AUTH_TOKEN=

# Database configuration (defaults to local SQLite)
# For production, use PostgreSQL (Supabase, Render, Neon, etc.)
# DATABASE_URL=sqlite:///./deployai.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Alternative: Individual DB parts (avoids @ in password breaking URL parsing)
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=

# Frontend URL for CORS (comma-separated list of production frontend URLs)
# Example: https://deployai-frontend.vercel.app,https://deployai-frontend.netlify.app
FRONTEND_URL=

# Optional: Supabase credentials (if using Supabase for database)
# SUPABASE_URL=
# SUPABASE_KEY=

# Optional: JWT Secret for authentication (if implementing auth)
# JWT_SECRET=

# Logging level
# LOG_LEVEL=INFO